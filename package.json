{
	"name": "ani2arr",
	"description": "Adds one-click Sonarr and Radarr actions to AniList/AniChart pages.",
	"private": true,
	"version": "2.1.0",
	"license": "GPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "wxt -b firefox",
		"dev:chrome": "wxt -b chrome",
		"build": "wxt build -b firefox",
		"build:chrome": "wxt build -b chrome",
		"build:all": "pnpm run build && pnpm run build:chrome",
		"zip": "wxt zip -b firefox",
		"zip:chrome": "wxt zip -b chrome",
		"zip:all": "pnpm run zip && pnpm run zip:chrome",
		"audit": "pnpm audit --audit-level high",
		"validate": "pnpm run audit && pnpm run lint && pnpm run compile && pnpm run test && pnpm run build:all",
		"compile": "tsc --noEmit",
		"postinstall": "wxt prepare",
		"lint": "eslint src",
		"lint:target": "eslint",
		"generate:anilist-metadata": "node ./scripts/generate-anilist-metadata.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky",
		"security:secrets": "gitleaks detect --source . --redact --verbose --no-git",
		"security": "pnpm run security:secrets && pnpm run audit"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx}": "eslint --fix"
	},
	"devDependencies": {
		"@babel/core": "^8.0.1",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@eslint/js": "^9.39.5",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"@wxt-dev/auto-icons": "^1.1.1",
		"@wxt-dev/webextension-polyfill": "^1.0.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^9.39.5",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-no-unsanitized": "^4.1.5",
		"eslint-plugin-playwright": "^2.11.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-unicorn": "^72.0.0",
		"globals": "^17.8.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "3.9.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.10",
		"wxt": "^0.21.3"
	},
	"dependencies": {
		"@radix-ui/react-alert-dialog": "^1.1.23",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-switch": "^1.3.7",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@tanstack/react-query": "^5.101.4",
		"@webext-core/proxy-service": "^3.0.2",
		"@wxt-dev/i18n": "^0.2.7",
		"@wxt-dev/storage": "^1.2.9",
		"clsx": "^2.1.1",
		"idb": "^8.0.3",
		"lucide-react": "^1.28.0",
		"p-queue": "^9.3.3",
		"p-retry": "^8.0.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"valibot": "^1.4.2"
	},
	"packageManager": "pnpm@11.7.0"
}
