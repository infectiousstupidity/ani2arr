{
	"name": "ani2arr",
	"description": "Adds one-click Sonarr and Radarr actions to AniList/AniChart pages.",
	"private": true,
	"version": "2.1.0",
	"license": "GPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "wxt -b firefox",
		"dev:chrome": "wxt -b chrome",
		"build": "wxt build -b firefox",
		"build:chrome": "wxt build -b chrome",
		"build:all": "pnpm run build && pnpm run build:chrome",
		"zip": "wxt zip -b firefox",
		"zip:chrome": "wxt zip -b chrome",
		"zip:all": "pnpm run zip && pnpm run zip:chrome",
		"audit": "pnpm audit --audit-level high",
		"validate": "pnpm run audit && pnpm run lint && pnpm run compile && pnpm run test && pnpm run build:all",
		"compile": "tsc --noEmit",
		"postinstall": "wxt prepare",
		"lint": "eslint src",
		"lint:target": "eslint",
		"generate:anilist-metadata": "node ./scripts/generate-anilist-metadata.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky",
		"security:secrets": "gitleaks detect --source . --redact --verbose --no-git",
		"security": "pnpm run security:secrets && pnpm run audit"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx}": "eslint --fix"
	},
	"devDependencies": {
		"@babel/core": "^8.1.3",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^9.39.5",
		"@rolldown/plugin-babel": "^0.2.4",
		"@tailwindcss/vite": "^4.3.5",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/parser": "^8.73.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@wxt-dev/auto-icons": "^1.1.2",
		"@wxt-dev/webextension-polyfill": "^1.0.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^9.39.5",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.18.1",
		"eslint-plugin-no-unsanitized": "^4.1.5",
		"eslint-plugin-playwright": "^2.12.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.8",
		"eslint-plugin-react-you-might-not-need-an-effect": "^1.2.0",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-unicorn": "^65.0.1",
		"globals": "^17.14.0",
		"happy-dom": "21.0.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1",
		"prettier": "3.9.5",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^4.1.12",
		"wxt": "^0.20.27"
	},
	"dependencies": {
		"@radix-ui/react-alert-dialog": "^1.2.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-scroll-area": "^1.4.0",
		"@radix-ui/react-select": "^2.4.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@tanstack/react-query": "^5.108.2",
		"@webext-core/proxy-service": "^2.0.1",
		"@wxt-dev/i18n": "^0.2.8",
		"clsx": "^2.1.1",
		"idb": "^8.0.4",
		"lucide-react": "^1.77.0",
		"p-queue": "^9.3.5",
		"p-retry": "^8.0.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.1",
		"valibot": "^1.5.0"
	},
	"packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
