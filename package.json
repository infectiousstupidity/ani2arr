{
	"name": "ani2arr",
	"description": "Adds one-click Sonarr and Radarr actions to AniList/AniChart pages.",
	"private": true,
	"version": "2.1.0",
	"license": "GPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "wxt -b firefox",
		"dev:chrome": "wxt -b chrome",
		"build": "wxt build -b firefox",
		"build:chrome": "wxt build -b chrome",
		"build:all": "pnpm run build && pnpm run build:chrome",
		"zip": "wxt zip -b firefox",
		"zip:chrome": "wxt zip -b chrome",
		"zip:all": "pnpm run zip && pnpm run zip:chrome",
		"audit": "pnpm audit --audit-level high",
		"validate": "pnpm run audit && pnpm run lint && pnpm run compile && pnpm run test && pnpm run build:all",
		"compile": "tsc --noEmit",
		"postinstall": "wxt prepare",
		"lint": "eslint src",
		"lint:target": "eslint",
		"generate:anilist-metadata": "node ./scripts/generate-anilist-metadata.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx}": "eslint --fix"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@eslint/js": "^9.39.4",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/vite": "^4.3.1",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^24.13.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"@wxt-dev/auto-icons": "^1.1.1",
		"@wxt-dev/webextension-polyfill": "^1.0.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^9.39.4",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-no-unsanitized": "^4.1.5",
		"eslint-plugin-playwright": "^2.10.4",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-unicorn": "^65.0.1",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"prettier": "3.8.3",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1",
		"vitest": "^4.1.9",
		"wxt": "^0.20.26"
	},
	"dependencies": {
		"@radix-ui/react-alert-dialog": "^1.1.17",
		"@radix-ui/react-dialog": "^1.1.17",
		"@radix-ui/react-dropdown-menu": "^2.1.18",
		"@radix-ui/react-label": "^2.1.10",
		"@radix-ui/react-scroll-area": "^1.2.12",
		"@radix-ui/react-select": "^2.3.1",
		"@radix-ui/react-slot": "^1.3.0",
		"@radix-ui/react-switch": "^1.3.1",
		"@radix-ui/react-tooltip": "^1.2.10",
		"@tanstack/react-query": "^5.101.0",
		"@webext-core/proxy-service": "^2.0.1",
		"@wxt-dev/i18n": "^0.2.5",
		"@wxt-dev/storage": "^1.2.8",
		"clsx": "^2.1.1",
		"idb": "^8.0.3",
		"lucide-react": "^1.21.0",
		"p-queue": "^9.3.0",
		"p-retry": "^8.0.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwind-merge": "^3.6.0",
		"valibot": "^1.4.1"
	},
	"packageManager": "pnpm@11.7.0"
}
